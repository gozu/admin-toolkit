/* Plugin agent: human-in-the-loop config/admin actuator */
{
    "meta": {
        "label": "ATK Ops Actuator",
        "description": "Human-in-the-loop admin actuator: plans admin actions with blast radius, waits for explicit user confirmation, executes via gated red endpoints, reports the audit id.",
        "icon": "icon-bolt"
    },
    "supportsImageInputs": false,
    "params": [
        {
            "name": "llm_id",
            "label": "LLM",
            "type": "STRING",
            "description": "LLM Mesh id (empty = plugin default).",
            "mandatory": false,
            "defaultValue": ""
        },
        {
            "name": "allow_red_actions",
            "label": "Allow red actions",
            "type": "BOOLEAN",
            "description": "Per-agent gate: OFF = this agent may plan but never execute.",
            "mandatory": false,
            "defaultValue": false
        },
        {
            "name": "allowed_actions",
            "label": "Allowed actions",
            "type": "STRING",
            "description": "Comma-separated allowlist (empty = all catalog actions). Highest-blast actions worth trimming first: connection-delete, cluster-detach, plugin-uninstall, project-delete (e.g. 'db-vacuum, db-analyze, connection-test' keeps a read-mostly actuator).",
            "mandatory": false,
            "defaultValue": ""
        }
    ]
}
