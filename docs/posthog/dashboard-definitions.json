          "kind": "TrendsQuery",
          "series": [
            {
              "kind": "EventsNode",
              "event": "adtk_module_opened",
              "math": "dau"
            }
          ],
          "interval": "week",
          "breakdownFilter": {
            "breakdown": "module_id",
            "breakdown_type": "event"
          }
        }
      },
