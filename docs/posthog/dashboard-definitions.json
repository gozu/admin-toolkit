[
  {
    "name": "Admin Toolkit \u2014 Customers",
    "tags": [
      "admin-toolkit-product-analytics-v1",
      "customer"
    ],
    "description": "Product usage, task funnels, and weekly/monthly retention. Internal = tam-global/akaos serving installations. All others = customers. Pseudonymous DSS users where available; browser fallback otherwise. Only installations with analytics enabled and working network access are represented.",
    "pinned": true,
    "insights": [
      {
        "name": "Admin Toolkit \u2014 Customers \u2014 Active users",
        "description": "Distinct pseudonymous users opening the app or navigating modules. Automatic scans do not count.",
        "tags": [
          "admin-toolkit-product-analytics-v1",
          "customer"
        ],
        "query": {
          "properties": [
            {
              "key": "audience",
              "type": "event",
              "operator": "exact",
              "value": [
                "customer"
              ]
            }
          ],
          "dateRange": {
            "date_from": "-90d"
          },
          "kind": "TrendsQuery",
          "series": [
            {
              "kind": "EventsNode",
              "event": "adtk_activity",
              "math": "dau"
            }
          ],
          "interval": "week"
        }
      },
      {
        "name": "Admin Toolkit \u2014 Customers \u2014 Module adoption",
