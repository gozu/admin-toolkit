/* Parameter set descriptor: remote DSS hosts the Admin Toolkit can scan. */
{
    "meta": {
        "label": "Remote DSS Hosts",
        "description": "A remote DSS instance this toolkit can scan.",
        "icon": "icon-server"
    },

    "defaultDefinableInline": false,
    "defaultDefinableAtProjectLevel": false,

    "params": [
        {
            "name": "label",
            "label": "Label",
            "description": "Display name for this host in the top-bar dropdown.",
            "type": "STRING",
            "mandatory": true
        },
        {
            "name": "url",
            "label": "URL (https://host:port)",
            "description": "Base URL of the remote DSS public API (no trailing slash).",
            "type": "STRING",
            "mandatory": true
        },
        {
            "name": "sep_apikey",
            "label": "Admin API Key",
            "description": "<strong>Recommended:</strong> add and manage remote hosts in the Admin Toolkit webapp → <em>Settings → Remote Hosts</em>, where the API key is encrypted for you automatically. To configure a host here instead, paste a pre-encrypted <code>adkfk1$…</code> blob into the field below. (The field is STRING, not PASSWORD: DSS would encrypt a PASSWORD param with a key the webapp backend can't read, so the toolkit does its own <code>adkfk1$</code> encryption.)",
            "type": "SEPARATOR"
        },
        {
            "name": "apiKey",
            "label": "Encrypted API key",
            "description": "Admin-level personal or global API key on the remote DSS, stored as an encrypted adkfk1$… blob. Prefer the webapp's Settings → Remote Hosts to add hosts — it encrypts the key for you.",
            "type": "STRING",
            "mandatory": true
        },
        {
            "name": "verifyTls",
            "label": "Verify TLS",
            "description": "Verify the remote's TLS certificate. Turn off only for dev hosts with self-signed certs.",
            "type": "BOOLEAN",
            "defaultValue": true
        },
        {
            "name": "backupProjectKey",
            "label": "Backup project key",
            "description": "Optional. Managed-folder backups use this project on the remote host. Leave blank to auto-detect the running Admin Toolkit webapp project.",
            "type": "STRING",
            "mandatory": false
        }
    ]
}
