/* Plugin agent: proactive fleet health triage */
{
    "meta": {
        "label": "ATK Health Triage",
        "description": "Fleet health triage: deterministic health-score sweep across DSS hosts, then grounded per-host recommendations. Ad-hoc health questions fall through to sensor tools.",
        "icon": "icon-stethoscope"
    },
    "supportsImageInputs": false,
    "params": [
        {
            "name": "llm_id",
            "label": "LLM",
            "type": "STRING",
            "description": "LLM Mesh id (empty = plugin default).",
            "mandatory": false,
            "defaultValue": ""
        },
        {
            "name": "hosts",
            "label": "Hosts",
            "type": "STRING",
            "description": "Comma-separated host ids to triage (empty = all configured hosts).",
            "mandatory": false,
            "defaultValue": ""
        },
        {
            "name": "score_threshold",
            "label": "Score threshold",
            "type": "INT",
            "description": "Hosts scoring below this are flagged for recommendations.",
            "mandatory": false,
            "defaultValue": 75
        },
        {
            "name": "max_recommendations",
            "label": "Max recommendations",
            "type": "INT",
            "mandatory": false,
            "defaultValue": 5
        }
    ]
}
